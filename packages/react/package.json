{
  "name": "@sumline/react",
  "version": "0.1.1",
  "description": "Sumline spreadsheet editor as a React component",
  "keywords": [
    "charts",
    "excel",
    "formula-engine",
    "office",
    "pdf",
    "react",
    "spreadsheet",
    "spreadsheet-editor",
    "typescript",
    "xlsx"
  ],
  "homepage": "https://github.com/mas-ony/office-sumline#readme",
  "bugs": {
    "url": "https://github.com/mas-ony/office-sumline/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mas-ony/office-sumline.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "author": "Ony Octavianto",
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./style.css"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./style.css": "./style.css"
    }
  },
  "files": [
    "dist",
    "style.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sumline/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "27.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
